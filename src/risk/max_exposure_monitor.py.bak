        """Store position risk summary for historical tracking."""
        
        try:
            # Store in JSON file
            timestamp = datetime.now().strftime('%Y%m%d_%H%M_%S')
            filename = f"position_risk_summary_{timestamp}.json"
            filepath = self.storage_path / filename
            
