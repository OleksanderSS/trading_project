+++ b/tests/test_evidence_intelligence_v6.py
@@ -0,0 +1,206 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from dean_os.briefing_contract import DailyBriefingBuilder
+from dean_os.briefing_renderer import DailyBriefingRenderer
+from dean_os.collector_routing import DomainCollectorRouter
+from dean_os.evidence_catalog import EvidenceCatalogBuilder
+from dean_os.evidence_dedup import SemanticEvidenceDeduplicator
+from dean_os.evidence_gap_planner_v2 import EvidenceGapPlanner
+from dean_os.operator_review_inbox_v2 import OperatorReviewInboxBuilder, SQLiteOperatorReviewInbox
+from dean_os.source_credibility import SourceCredibilityRegistry
+
+from tests.test_daily_agent_run import AS_OF, _system_result
+
+
+def test_source_credibility_is_domain_aware_and_not_truth_oracle():
+    registry = SourceCredibilityRegistry.from_domain_profile("semiconductor_ai_infrastructure")
+    official = registry.assess({"source": "official_company_release", "source_type": "report"}, point_in_time_status="valid")
+    weak = registry.assess({"source": "stocktwits", "source_type": "news"}, point_in_time_status="valid")
+    assert official.source_tier == "tier_1_core_evidence"
+    assert official.credibility_score > weak.credibility_score
+    assert weak.decision_use == "lead_only"
