+def test_topology_rejects_dependency_cycles():
+    raw = load_default_system_topology().model_dump(mode="json")
+    raw["topology_hash"] = ""
+    raw["branches"][0]["depends_on"] = ["daily_audit"]
+    with pytest.raises(ValueError, match="cycle"):
+        SystemTopology(**raw)
