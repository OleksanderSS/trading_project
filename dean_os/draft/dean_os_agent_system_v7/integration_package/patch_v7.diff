+            "processed_data": {"news": [{"title": "Processed HBM item", "published_at": AS_OF}]},
+            "features_df": [{"ticker": "NVDA", "feature": 1.0}],
+        },
+    }
+    packet = PipelineStage03Bridge().build_packet(
+        result,
+        as_of=AS_OF,
+        knowledge_cutoff=AS_OF,
