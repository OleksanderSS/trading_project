    "scenario_id": "string",
    "started_at": "datetime",
    "completed_at": "datetime | null",
    "mode": "research | replay | paper | shadow",
    "components_tested": [
      "collectors",
      "normalizers",
      "analyst_agents",
      "macro_regime",
      "hypothesis_ledger",
      "strategy_library",
      "pipeline_controller",
      "portfolio_governance",
      "risk_engine",
      "execution_gateway",
      "audit_review"
    ],
    "input_state": {
