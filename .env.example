# ============================================================================
# API Keys & Credentials
# ============================================================================

# Polygon.io API (for financial data)
POLYGON_API_KEY=your_polygon_api_key_here

# Yahoo Finance API (optional)
YAHOO_API_KEY=your_yahoo_api_key_here

# News API (optional)
NEWS_API_KEY=your_news_api_key_here

# ============================================================================
# Database Configuration
# ============================================================================

# SQLite (default)
DATABASE_URL=sqlite:///data/trading_data.db

# PostgreSQL (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_db

# ============================================================================
# Google Cloud Platform (for Colab)
# ============================================================================

# GCP Project ID
GCP_PROJECT_ID=your_gcp_project_id

# GCP Credentials (path to JSON file)
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp_credentials.json

# ============================================================================
# System Configuration
# ============================================================================

# Operating mode (development, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum number of workers
MAX_WORKERS=4

# ============================================================================
# Model Training
# ============================================================================

# Monitoring & Alerting
MONITORING_EMAIL_USER=your_monitoring_email_user
MONITORING_EMAIL_PASS=your_monitoring_email_password
MONITORING_SLACK_WEBHOOK=https://hooks.slack.com/services/your/slack/webhook
TRADING_ENV=development

# Maximum iterations for tree models
MAX_ITERATIONS=100

# Number of epochs for heavy models
EPOCHS=50

# Batch size for neural networks
BATCH_SIZE=32

# ============================================================================
# Feature Engineering
# ============================================================================

# Maximum number of features
MAX_FEATURES=120

# Minimum number of features
MIN_FEATURES=20

# ============================================================================
# Trading Configuration
# ============================================================================

# Initial capital (USD)
INITIAL_CAPITAL=10000

# Maximum risk per position (%)
MAX_POSITION_RISK=2.0

# Broker commission (%)
COMMISSION_RATE=0.1

# ============================================================================
# Cache & Storage
# ============================================================================

# Cache time-to-live (hours)
CACHE_TTL_HOURS=24

# Maximum cache size (MB)
MAX_CACHE_SIZE_MB=1000

# ============================================================================
# Notifications (optional)
# ============================================================================

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email for notifications
NOTIFICATION_EMAIL=your_email@example.com

# ============================================================================
# Notes
# ============================================================================
# 1. Copy this file as .env
# 2. Fill in real values
# 3. DO NOT commit .env to Git (it's in .gitignore)
# 4. For production use environment variables or secrets manager
