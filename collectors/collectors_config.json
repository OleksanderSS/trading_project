          "https://feeds.feedburner.com/entrepreneur/latest",
          "https://feeds.finviz.com/rss.ashx",
          "https://feeds.feedburner.com/Moneycontrol/marketnews"
        ],
        "similarity_threshold": 0.85,
        "delay_range": [
          1.0,
          3.0
        ],
        "max_articles_per_feed": 100,
        "sentiment_analysis": true,
        "source_classification": true
      }
    },
    "gdelt": {
      "name": "GDELT Collector",
      "type": "events",
      "enabled": true,
      "max_retries": 3,
      "timeout": 60,
      "rate_limit": 1000,
      "cache_enabled": true,
      "cache_ttl": 7200,
      "batch_size": 1000,
      "validate_data": true,
      "additional_params": {
        "default_languages": [
          "en"
        ],
        "default_topics": [
          "Economy",
          "Finance",
          "Trade"
        ],
        "bigquery_project_env": "GDELT_PROJECT_ID",
        "bigquery_dataset": "gdelt-bq.gdeltv2",
        "enable_event_filtering": true,
        "use_json_api": true,
        "json_api_key_env": "GDELT_API_KEY",
        "use_bigquery": true,
        "service_account_path": "config/google_key.json",
        "max_events_per_request": 500,
        "focus_indicators": [
          "GLOBALEVENTID",
          "EVENTROOTCODE",
          "EVENTCODE",
          "ACTIONGEOCODE",
          "NUMARTICLES"
        ],
        "economical_mode": true,
        "threshold_strategy": "tiered",
        "base_threshold": 10,
        "regional_thresholds": {
          "US": 5,
          "EU": 5,
          "CN": 5,
          "JP": 5,
          "UK": 7,
          "CA": 7,
          "AU": 7,
          "DE": 7,
          "FR": 7,
          "IT": 7,
          "ES": 7
        },
        "event_type_thresholds": {
          "041": 5,
          "042": 5,
          "043": 5,
          "071": 7,
          "072": 7,
          "073": 7,
          "074": 7,
          "081": 15,
          "082": 15,
          "083": 15,
          "084": 15,
          "091": 12,
          "092": 12,
          "093": 12,
          "094": 12,
          "05": 20
        },
        "time_decay_thresholds": {
          "recent_hours": 24,
          "recent_threshold": 5,
          "normal_threshold": 10
        },
        "max_storage_gb": 1000.0,
        "data_retention_days": 365,
        "compression_enabled": true,
        "min_mentions_threshold": 3,
        "economic_event_codes": [
          "04",
          "05",
          "071",
          "072",
          "073",
          "074",
          "081",
          "082",
          "083",
          "084",
          "091",
          "092",
          "093",
          "094"
        ]
      }
